# Public application URL (used in email links and Stripe redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Postgres (required on Vercel / multi-instance). Leave empty for local .data/db.json file store.
# Neon example: postgresql://user:pass@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Admin bootstrap — the first account registered with this email gets the admin role.
# Existing accounts with this email are promoted to admin at login.
ADMIN_EMAIL=

# OpenAI — server-side only; never expose this key in NEXT_PUBLIC variables.
# Leave empty to run in demo mode (static demo responses, no external calls).
OPENAI_API_KEY=
# Optional model overrides (defaults: gpt-4o-mini / dall-e-3)
OPENAI_MODEL=
OPENAI_IMAGE_MODEL=

# Stripe — configure before enabling paid plans
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=

# Email (Resend) — configure before enabling email verification and password reset.
# Leave empty in development: verification/reset tokens are logged to the server console.
RESEND_API_KEY=
EMAIL_FROM=noreply@aiforge.example.com
